# Normalise line endings so patches and shell scripts behave the same
# on every machine. Binary and result files are left untouched.
*           text=auto eol=lf
*.py        text eol=lf
*.smk       text eol=lf
*.sh        text eol=lf
*.R         text eol=lf
*.yaml      text eol=lf
*.tsv       text eol=lf
Snakefile   text eol=lf
*.mpi       binary
*.png       binary
*.pdf       binary
*.xlsx      binary
*.docx      binary
*.gz        binary
